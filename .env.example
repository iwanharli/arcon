# Ambil dari https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=abcdef0123456789abcdef0123456789
TG_PHONE=+62812xxxxxxx
TG_SESSION=artemis

# Bot target (username tanpa @, atau numeric id). BOT_3 opsional/kosong.
BOT_1=teamkhususantibanditbot
BOT_2=Getphoneplusbot
BOT_3=

# Detik menunggu balasan bot
BOT_TIMEOUT=30

# Umur maksimal hasil 'found' yang boleh disajikan dari cache (hari).
# 0 = tanpa batas. Command volatile (lokasi) tidak pernah dari cache.
CACHE_HARI=30

# Halaman TAMBAHAN yang diikuti saat bot memotong daftar hasil
# ("Ditemukan: 17 data | Halaman 1/5", tombol 📄/Next). 0 = hanya halaman
# pertama (perilaku lama). Dipakai kalau kelengkapan data lebih penting
# daripada hemat kuota harian per fitur.
HALAMAN_MAKS=0

# Batas per command, mis. "nik=4,imigrasi=4" (nama command TANPA garis miring;
# kosongkan = pakai HALAMAN_MAKS). Berguna kalau cuma fitur tertentu — mis.
# /nik yang menyisipkan blok IMIGRASI berpaginasi — yang perlu ditarik utuh.
HALAMAN_MAKS_CMD=

# Database Postgres (cache query + hasil ternormalisasi)
PG_DSN=postgresql:///db_artemis

# API untuk aplikasi Artemis (kosongkan API_KEY untuk mematikan autentikasi)
API_KEY=

# Bot antarmuka Telegram (frontend API) - token dari @BotFather
TG_BOT_TOKEN=
BOT_ADMIN_IDS=
