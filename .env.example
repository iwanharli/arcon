# Ambil dari https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=abcdef0123456789abcdef0123456789
TG_PHONE=+62812xxxxxxx
TG_SESSION=artemis

# 3 bot target (username tanpa @, atau numeric id)
BOT_1=bot_pertama_bot
BOT_2=bot_kedua_bot
BOT_3=bot_ketiga_bot

# Detik menunggu balasan bot
BOT_TIMEOUT=30

# Database Postgres (cache query + hasil ternormalisasi)
PG_DSN=postgresql:///db_artemis

# API untuk aplikasi Artemis (kosongkan API_KEY untuk mematikan autentikasi)
API_KEY=

# Bot antarmuka Telegram (frontend API) - token dari @BotFather
TG_BOT_TOKEN=
BOT_ADMIN_IDS=
